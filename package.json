{
  "name": "bookcase",
  "private": true,
  "description": "A web app for keeping track of your personal book collection.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tjsanterre/bookcase.git"
  },
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.dev.vars node_modules/vite/bin/vite.js",
    "build": "vite build",
    "test": "vitest run --root .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.dev.vars node_modules/drizzle-kit/bin.cjs migrate",
    "typecheck": "tsc --noEmit && vue-tsc --noEmit -p tsconfig.web.json",
    "preview": "vite preview",
    "deploy": "wrangler deploy --config dist/bookcase/wrangler.json"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.0",
    "barcode-detector": "^3.2.2",
    "better-auth": "^1.7.15",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.13",
    "pg": "^8.23.1",
    "vue": "^3.5.43",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.67.0",
    "@types/node": "^26.6.4",
    "@types/pg": "^8.23.1",
    "@vitejs/plugin-vue": "^6.0.9",
    "drizzle-kit": "^0.31.11",
    "typescript": "^5.9.3",
    "vite": "^8.3.3",
    "vitest": "^5.0.3",
    "vue-tsc": "^3.3.12",
    "wrangler": "^4.157.0"
  }
}
