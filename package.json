{
  "name": "bookcase",
  "private": true,
  "description": "A web app for keeping track of your personal book collection.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tjsanterre/bookcase.git"
  },
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web \"node --watch --env-file-if-exists=.dev.vars src/server/index.ts\" \"node --env-file-if-exists=.dev.vars node_modules/vite/bin/vite.js\"",
    "build": "vite build",
    "start": "node --env-file-if-exists=.dev.vars src/server/index.ts",
    "test": "vitest run --root .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.dev.vars node_modules/drizzle-kit/bin.cjs migrate",
    "typecheck": "tsc --noEmit && vue-tsc --noEmit -p tsconfig.web.json"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "@neondatabase/serverless": "^1.2.0",
    "barcode-detector": "^3.2.2",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.13",
    "pg": "^8.23.1",
    "vue": "^3.5.43",
    "vue-router": "^5.3.1",
    "ws": "^8.22.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-vue": "^6.0.9",
    "concurrently": "^10.0.5",
    "drizzle-kit": "^0.31.11",
    "typescript": "^5.9.3",
    "vite": "^8.3.3",
    "vitest": "^5.0.3",
    "vue-tsc": "^3.3.12"
  }
}
