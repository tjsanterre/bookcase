{
  "name": "bookcase",
  "private": true,
  "description": "A web app for keeping track of your personal book collection.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tjsanterre/bookcase.git"
  },
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web \"node --watch --env-file-if-exists=.env src/server/index.ts\" \"node --env-file-if-exists=.env node_modules/vite/bin/vite.js\"",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env src/server/index.ts",
    "test": "vitest run --root .",
    "typecheck": "tsc --noEmit && vue-tsc --noEmit -p tsconfig.web.json"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "barcode-detector": "^3.2.2",
    "better-sqlite3": "^13.0.3",
    "hono": "^4.13.13",
    "vue": "^3.5.43"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.4",
    "@vitejs/plugin-vue": "^6.0.9",
    "concurrently": "^10.0.5",
    "typescript": "^5.9.3",
    "vite": "^8.3.3",
    "vitest": "^5.0.3",
    "vue-tsc": "^3.3.12"
  }
}
